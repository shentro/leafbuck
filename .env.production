# ── LeafBuck Console — Production Environment ────────────────────
# Set these in Coolify's Environment Variables panel.

NEXT_PUBLIC_SITE_URL=https://leafbuck.com
NEXT_PUBLIC_CONSOLE_URL=https://console.leafbuck.com

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
RESEND_API_KEY=re_your-key-here

BITLABS_POSTBACK_SECRET=your-bitlabs-secret
CPX_POSTBACK_SECRET=your-cpx-secret
LOOTABLY_POSTBACK_SECRET=your-lootably-secret
