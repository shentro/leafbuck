# ── LeafBuck Console — Local Development Environment ─────────────
# Copy this file to .env.local and fill in values.
# Never commit .env.local to git.

# The URL of the public marketing site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The URL of this console app itself
NEXT_PUBLIC_CONSOLE_URL=http://localhost:3001

# Supabase (get these from supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Keep this SECRET — never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend (for transactional emails — resend.com)
RESEND_API_KEY=re_your-key-here

# Offerwall postback secrets (set these once you have provider accounts)
BITLABS_POSTBACK_SECRET=your-bitlabs-secret
CPX_POSTBACK_SECRET=your-cpx-secret
LOOTABLY_POSTBACK_SECRET=your-lootably-secret
